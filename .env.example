# Copy to .env.local for Next.js, and set the Convex ones with `npx convex env set NAME value`.

# Next.js
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# Which sign in buttons the login page shows, "true" to show one.
NEXT_PUBLIC_AUTH_DISCORD=false
NEXT_PUBLIC_AUTH_RESEND=false
NEXT_PUBLIC_ALLOW_GUEST=false

# Convex deployment: auth
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_RESEND_KEY=
# Registers the Anonymous provider, guest sign in is off unless this is "true".
AUTH_ALLOW_GUEST=false

# Convex deployment: email
RESEND_API_KEY=
# Verified sender domain, the from address is alerts@EMAIL_DOMAIN.
EMAIL_DOMAIN=voidwatch.app

# Convex deployment: agent
OPENAI_API_KEY=

# Convex deployment: Photon iMessage
SPECTRUM_PROJECT_ID=550d43e3-1cd6-456d-93b8-335451754842
SPECTRUM_PROJECT_SECRET=
PHOTON_WEBHOOK_SECRET=

# Where emails link back to.
SITE_URL=https://voidwatch.app
